# SafetyVision AI Configuration
# Copy this to .env and update with your values

# ===============================
# DEPLOYMENT MODE
# ===============================
# Options: development, demo, production
DEPLOYMENT_MODE=development

# ===============================
# PERFORMANCE SETTINGS
# ===============================
# Target frames per second
TARGET_FPS=10

# Optimization level: high, balanced, optimized, extreme
OPTIMIZATION_LEVEL=balanced

# Use GPU for inference (requires CUDA)
USE_GPU=false

# ===============================
# DEMO MODE (for competitions)
# ===============================
# Automatically load sample videos from samples/ directory
# Precomputed results stored in samples/precomputed/

# ===============================
# RTSP/SURVEILLANCE
# ===============================
# RTSP camera URL
# Example: rtsp://username:password@192.168.1.100:554/stream
RTSP_URL=

# RTSP authentication
RTSP_USERNAME=
RTSP_PASSWORD=

# RTSP connection timeout (seconds)
RTSP_TIMEOUT=10

# RTSP reconnection interval (seconds)
RTSP_RECONNECT_INTERVAL=5

# ===============================
# ONVIF CAMERA SUPPORT
# ===============================
# Enable ONVIF protocol for IP cameras
ONVIF_ENABLED=false

# ONVIF camera host
ONVIF_HOST=
ONVIF_PORT=8080

# ONVIF authentication
ONVIF_USERNAME=
ONVIF_PASSWORD=

# ===============================
# TELEGRAM ALERTS
# ===============================
# Get these from @BotFather on Telegram

# Telegram bot token
BOT_TOKEN=

# Telegram chat ID
CHAT_ID=

# Minimum severity to send Telegram alerts
# Options: info, warning, high, critical
MIN_TELEGRAM_SEVERITY=high

# Send frame snapshots with alerts
SEND_SNAPSHOTS=true

# ===============================
# LOGGING
# ===============================
# Alert log file path
LOG_FILE=logs/alerts.log

# ===============================
# DOCKER (for production)
# ===============================
# Port to expose
APP_PORT=8000

# CPU limit (cores)
CPU_LIMIT=2

# Memory limit
MEMORY_LIMIT=2G

# CPU reservation
CPU_RESERVE=1

# Memory reservation
MEMORY_RESERVE=1G
